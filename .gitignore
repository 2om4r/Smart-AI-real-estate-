# ───────── Python / venv ─────────
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# ───────── Secrets ─────────
.env
.env.*
!.env.example
*firebase-adminsdk*.json
cookie.txt

# ───────── Runtime data (regenerated at startup / training) ─────────
# Flask SQLite database lives here — never commit
instance/
# RAG vector store — rebuilt from DB on every startup
chroma_db/
# Trained ML model (117 MB) — regenerated by scripts/train_from_db.py
*.pkl
ml_model_trained.pkl
# ML model registry — all versioned pickles + symlinks
models/registry/
# Model backups (auto-generated daily)
models/backups/

# ───────── User uploads ─────────
static/uploads/properties/*
!static/uploads/properties/.gitkeep
static/uploads/profiles/

# ───────── OS / Editor noise ─────────
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ───────── IDE / Claude config ─────────
.claude/
.vscode/
.idea/

# ───────── Node.js (used only for docs/ Word generator) ─────────
node_modules/
package-lock.json
